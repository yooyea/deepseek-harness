# Host port exposed by Docker Compose.
HARNESS_PORT=8080

# Image tag to deploy. Use latest or an immutable sha-<commit> tag.
HARNESS_IMAGE_TAG=latest

# Public IP or domain used by the browser, without scheme or path.
DSH_TRUSTED_HOST=203.0.113.10

# Basic Auth credentials for the Harness Web UI.
DSH_ACCESS_USER=admin
DSH_ACCESS_PASSWORD=replace-with-a-long-random-password

# Tenant control-plane administrator and public endpoint.
CONTROL_PLANE_PORT=8090
CONTROL_PLANE_IMAGE_TAG=control-plane-latest
CONTROL_PLANE_ADMIN_USER=admin
CONTROL_PLANE_ADMIN_PASSWORD=replace-with-a-different-long-random-password
CONTROL_PLANE_PUBLIC_HOST=203.0.113.10

# Direct tenant instance URLs and port allocation range.
TENANT_PUBLIC_SCHEME=http
TENANT_PORT_START=8100
TENANT_PORT_END=8199

# Per-tenant resource limits.
TENANT_DEFAULT_CPU=1
TENANT_DEFAULT_MEMORY_MB=1536

# Admission thresholds.
CAPACITY_MAX_CPU_PERCENT=70
CAPACITY_MAX_LOAD_RATIO=0.9
CAPACITY_MIN_FREE_MEMORY_MB=2048
CAPACITY_MIN_FREE_DISK_PERCENT=15
CAPACITY_CPU_RESERVATION_RATIO=0.8
